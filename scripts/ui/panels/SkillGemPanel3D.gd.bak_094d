extends Control

const SlotButtonScript := preload("res://scripts/ui/widgets/UISlotButton3D.gd")
const SkillGemSystemScript := preload("res://scripts/systems/SkillGemSystem3D.gd")
const GemDBScript := preload("res://scripts/data/GemDB3D.gd")

const MAX_ACTIVE_SLOTS: int = 4
const MAX_SUPPORT_SOCKETS: int = 6
const STARTING_SUPPORT_SOCKETS: int = 2
const SOCKET_LEVEL_INTERVAL: int = 5

const DEFAULT_ACTIVE_GEMS: Array = ["fireball", "storm_lance", "arc_slash", "void_rift"]
const DEFAULT_SUPPORT_GEMS: Array = ["pierce", "chain", "echo", "ignite", "overload", "swift_casting"]
const DEFAULT_SPIRIT_GEMS: Array = ["ember_aura", "storm_focus", "void_pact"]

const SkillGemUXSystemScript := preload("res://scripts/systems/SkillGemUXSystem3D.gd")
const UIFoundationSystemScript := preload("res://scripts/systems/UIFoundationSystem3D.gd")
var _rf_092c_skill_detail: RichTextLabel = null
var _rf_092c_skill_timer: Timer = null
var active_slot_box: VBoxContainer = null
var detail_label: RichTextLabel = null
var support_socket_grid: GridContainer = null
var active_stash_grid: GridContainer = null
var support_stash_grid: GridContainer = null
var spirit_box: VBoxContainer = null
var remove_active_drop: Control = null
var spirit_summary_label: Label = null
var close_button: Button = null

var state_ref: Object = null
var selected_spirit_index: int = -1

func _ready() -> void:
	call_deferred("_rf_094a_ensure_panel_foundation", "skills")
	call_deferred("_rf_092c_ensure_skill_ux")
	_bind_nodes()
	if close_button != null:
		close_button.pressed.connect(_close_panel)

func bind_state(state: Object) -> void:
	update_from_state(state)

func update_from_state(state: Object) -> void:
	state_ref = state
	if active_slot_box == null:
		_bind_nodes()
	_ensure_model()
	_rebuild()

func _bind_nodes() -> void:
	active_slot_box = get_node_or_null("RootHBox/ActiveColumn/ActivePanel/ActiveMargin/ActiveVBox/ActiveSlotBox") as VBoxContainer
	remove_active_drop = get_node_or_null("RootHBox/ActiveColumn/ActivePanel/ActiveMargin/ActiveVBox/RemoveActiveDrop") as Control
	detail_label = get_node_or_null("RootHBox/MainColumn/SkillDetailPanel/DetailMargin/DetailVBox/DetailLabel") as RichTextLabel
	support_socket_grid = get_node_or_null("RootHBox/MainColumn/SkillDetailPanel/DetailMargin/DetailVBox/SupportSocketGrid") as GridContainer
	active_stash_grid = get_node_or_null("RootHBox/MainColumn/StashPanel/StashMargin/StashVBox/StashColumns/ActiveStashPanel/ActiveStashMargin/ActiveStashGrid") as GridContainer
	support_stash_grid = get_node_or_null("RootHBox/MainColumn/StashPanel/StashMargin/StashVBox/StashColumns/SupportStashPanel/SupportStashMargin/SupportStashGrid") as GridContainer
	spirit_box = get_node_or_null("RootHBox/MainColumn/StashPanel/StashMargin/StashVBox/StashColumns/SpiritPanel/SpiritMargin/SpiritVBox/SpiritBox") as VBoxContainer
	spirit_summary_label = get_node_or_null("RootHBox/MainColumn/StashPanel/StashMargin/StashVBox/SpiritSummaryLabel") as Label
	close_button = get_node_or_null("RootHBox/MainColumn/HeaderBar/CloseButton") as Button

func _state_get(key: String, fallback: Variant = null) -> Variant:
	if state_ref == null:
		return fallback
	var v: Variant = state_ref.get(key)
	return fallback if v == null else v

func _state_set(key: String, value: Variant) -> void:
	if state_ref != null:
		state_ref.set(key, value)

func _clear(root: Node) -> void:
	if root == null:
		return
	for child in root.get_children():
		child.queue_free()

func _ensure_model() -> void:
	if state_ref == null:
		return

	SkillGemSystemScript.ensure_defaults(state_ref)

	var active_slots: Array = Array(_state_get("active_skill_slots", []))
	while active_slots.size() < MAX_ACTIVE_SLOTS:
		active_slots.append(_new_active(DEFAULT_ACTIVE_GEMS[active_slots.size() % DEFAULT_ACTIVE_GEMS.size()]))

	for i in range(active_slots.size()):
		if typeof(active_slots[i]) != TYPE_DICTIONARY:
			active_slots[i] = _new_active(DEFAULT_ACTIVE_GEMS[i % DEFAULT_ACTIVE_GEMS.size()])
		else:
			var slot: Dictionary = Dictionary(active_slots[i])
			var id: String = str(slot.get("gem_id", slot.get("active", slot.get("active_id", DEFAULT_ACTIVE_GEMS[i % DEFAULT_ACTIVE_GEMS.size()]))))
			slot["kind"] = "active"
			slot["gem_id"] = id
			slot["active"] = id
			slot["active_id"] = id
			slot["level"] = max(1, _safe_int(slot.get("level", 1), 1))
			slot["xp"] = max(0, _safe_int(slot.get("xp", 0), 0))
			slot["quality"] = clampi(_safe_int(slot.get("quality", 0), 0), 0, 100)
			slot["supports"] = Array(slot.get("supports", []))
			active_slots[i] = slot

	_state_set("active_skill_slots", active_slots)
	_state_set("selected_skill_slot", clampi(_safe_int(_state_get("selected_skill_slot", 0), 0), 0, max(0, active_slots.size() - 1)))

	var stash: Dictionary = _gem_stash()
	if not stash.has("active"):
		stash["active"] = []
	if not stash.has("support"):
		stash["support"] = _support_stash_from_owned()
	if not stash.has("spirit"):
		stash["spirit"] = _spirit_stash_from_owned()
	_state_set("gem_stash", stash)

	var spirit_slots: Array = Array(_state_get("spirit_gem_slots", []))
	if spirit_slots.is_empty():
		var old_spirits: Dictionary = Dictionary(_state_get("spirit_gems_owned", {}))
		if old_spirits.is_empty():
			for sid in DEFAULT_SPIRIT_GEMS:
				spirit_slots.append(_new_spirit(str(sid), false))
		else:
			for key in old_spirits.keys():
				spirit_slots.append(_new_spirit(str(key), bool(old_spirits[key])))

	for s in range(spirit_slots.size()):
		if typeof(spirit_slots[s]) != TYPE_DICTIONARY:
			spirit_slots[s] = _new_spirit(str(spirit_slots[s]), false)
		else:
			var spirit: Dictionary = Dictionary(spirit_slots[s])
			var spid: String = str(spirit.get("gem_id", spirit.get("id", "")))
			spirit["kind"] = "spirit"
			spirit["gem_id"] = spid
			spirit["enabled"] = bool(spirit.get("enabled", false))
			spirit["level"] = max(1, _safe_int(spirit.get("level", 1), 1))
			spirit["xp"] = max(0, _safe_int(spirit.get("xp", 0), 0))
			spirit["quality"] = clampi(_safe_int(spirit.get("quality", 0), 0), 0, 100)
			spirit["supports"] = Array(spirit.get("supports", []))
			spirit_slots[s] = spirit

	_state_set("spirit_gem_slots", spirit_slots)
	_recompute_spirit_reservation()

func _new_active(id: String) -> Dictionary:
	return {"kind":"active", "gem_id":id, "active":id, "active_id":id, "level":1, "xp":0, "quality":0, "supports":[]}

func _new_support(id: String) -> Dictionary:
	return {"kind":"support", "gem_id":id, "level":1, "xp":0, "quality":0}

func _new_spirit(id: String, enabled: bool) -> Dictionary:
	return {"kind":"spirit", "gem_id":id, "enabled":enabled, "level":1, "xp":0, "quality":0, "supports":[]}

func _support_stash_from_owned() -> Array:
	var out: Array = []
	var owned: Dictionary = Dictionary(_state_get("support_gems_owned", {}))
	if owned.is_empty():
		for id in DEFAULT_SUPPORT_GEMS:
			out.append(_new_support(str(id)))
	else:
		for key in owned.keys():
			var count: int = max(1, _safe_int(owned[key], 1))
			for _i in range(count):
				out.append(_new_support(str(key)))
	return out

func _spirit_stash_from_owned() -> Array:
	var out: Array = []
	var owned: Dictionary = Dictionary(_state_get("spirit_gems_owned", {}))
	if owned.is_empty():
		for id in DEFAULT_SPIRIT_GEMS:
			out.append(_new_spirit(str(id), false))
	else:
		for key in owned.keys():
			out.append(_new_spirit(str(key), false))
	return out

func _gem_stash() -> Dictionary:
	var v: Variant = _state_get("gem_stash", {})
	return Dictionary(v) if typeof(v) == TYPE_DICTIONARY else {}

func _rebuild() -> void:
	_clear(active_slot_box)
	_clear(remove_active_drop)
	_clear(support_socket_grid)
	_clear(active_stash_grid)
	_clear(support_stash_grid)
	_clear(spirit_box)
	_rebuild_active_slots()
	_rebuild_support_sockets()
	_rebuild_stash()
	_rebuild_spirit()
	_refresh_detail()

func _rebuild_active_slots() -> void:
	var active_slots: Array = Array(_state_get("active_skill_slots", []))
	var selected: int = _selected_slot_index()

	for i in range(active_slots.size()):
		var slot: Dictionary = Dictionary(active_slots[i])
		var id: String = str(slot.get("gem_id", ""))
		var level: int = _safe_int(slot.get("level", 1), 1)
		var b: Button = SlotButtonScript.new()
		b.custom_minimum_size = Vector2(118, 92)
		b.setup(
			"active_slot_%d" % i,
			"◎\n" + _short(_active_name(id), 12) + "\nLv " + str(level),
			{"kind":"equipped_active_gem", "slot_index":i},
			["active_gem"],
			i == selected,
			_active_tip(slot),
			Color(0.75, 0.88, 1.0, 1.0),
			true
		)
		b.slot_clicked.connect(_select_active_slot)
		b.slot_double_clicked.connect(_select_active_slot)
		b.slot_dropped.connect(_drop_active_onto_slot)
		if active_slot_box != null:
			active_slot_box.add_child(b)

	if remove_active_drop != null:
		var drop: Button = SlotButtonScript.new()
		drop.custom_minimum_size = Vector2(118, 58)
		drop.setup("active_remove_drop", "Drag Active\nTo Stash", {"kind":"active_remove_zone"}, ["equipped_active_gem"], false, "Drop equipped active gem here to stash it with supports intact.", Color(0.55,0.55,0.55,1), false)
		drop.slot_dropped.connect(_drop_active_to_stash)
		remove_active_drop.add_child(drop)

func _rebuild_support_sockets() -> void:
	if support_socket_grid == null:
		return
	support_socket_grid.columns = 3
	var slot: Dictionary = _selected_active_slot()
	var supports: Array = Array(slot.get("supports", []))
	var unlocked: int = _unlocked_sockets(slot)

	for i in range(MAX_SUPPORT_SOCKETS):
		var b: Button = SlotButtonScript.new()
		b.custom_minimum_size = Vector2(132, 58)
		if i >= unlocked:
			b.setup("support_socket_%d" % i, "LOCKED\nLv " + str(i * SOCKET_LEVEL_INTERVAL), {"kind":"locked_socket", "socket_index":i}, [], false, "Unlocks by leveling this skill.", Color(0.32,0.32,0.32,0.75), false)
			b.disabled = true
		elif i < supports.size():
			var sid: String = _support_id(supports[i])
			b.setup("support_socket_%d" % i, "S\n" + _short(_support_name(sid), 14), {"kind":"socketed_support", "socket_index":i, "support_id":sid}, ["support_gem"], false, _support_tip(sid) + "\nRight/double-click removes.", Color(0.55,0.75,1.0,1), true)
			b.slot_right_clicked.connect(_remove_support_from_selected)
			b.slot_double_clicked.connect(_remove_support_from_selected)
			b.slot_dropped.connect(_drop_support_onto_active_socket)
		else:
			b.setup("support_socket_%d" % i, "EMPTY\nSupport", {"kind":"empty_support_socket", "socket_index":i}, ["support_gem"], false, "Drop compatible support gem here.", Color(0.9,0.9,0.9,1), false)
			b.slot_dropped.connect(_drop_support_onto_active_socket)
		support_socket_grid.add_child(b)

func _rebuild_stash() -> void:
	var stash: Dictionary = _gem_stash()
	var active_stash: Array = Array(stash.get("active", []))
	var support_stash: Array = Array(stash.get("support", []))
	var selected_active_id: String = str(_selected_active_slot().get("gem_id", ""))

	for i in range(active_stash.size()):
		if typeof(active_stash[i]) != TYPE_DICTIONARY:
			continue
		var gem: Dictionary = Dictionary(active_stash[i])
		var id: String = str(gem.get("gem_id", ""))
		var b: Button = SlotButtonScript.new()
		b.custom_minimum_size = Vector2(118, 54)
		b.setup("stash_active_%d" % i, _short(_active_name(id), 14) + "\nLv " + str(_safe_int(gem.get("level", 1), 1)), {"kind":"active_gem", "stash_index":i}, [], false, _active_tip(gem), Color(0.75,0.88,1,1), true)
		b.slot_clicked.connect(_install_active_from_stash)
		b.slot_double_clicked.connect(_install_active_from_stash)
		if active_stash_grid != null:
			active_stash_grid.add_child(b)

	for j in range(support_stash.size()):
		if typeof(support_stash[j]) != TYPE_DICTIONARY:
			continue
		var sg: Dictionary = Dictionary(support_stash[j])
		var sid: String = str(sg.get("gem_id", ""))
		var compatible: bool = GemDBScript.support_compatible(selected_active_id, sid)
		var sb: Button = SlotButtonScript.new()
		sb.custom_minimum_size = Vector2(118, 46)
		sb.setup("stash_support_%d" % j, _short(_support_name(sid), 14), {"kind":"support_gem", "stash_index":j, "gem_id":sid}, [], false, _support_tip(sid), Color(0.55,0.75,1,1), true)
		if compatible:
			sb.slot_clicked.connect(_install_support_from_stash)
			sb.slot_double_clicked.connect(_install_support_from_stash)
		else:
			sb.set_disabled_reason("Not compatible with selected active skill.")
		if support_stash_grid != null:
			support_stash_grid.add_child(sb)

func _rebuild_spirit() -> void:
	var spirit_slots: Array = Array(_state_get("spirit_gem_slots", []))
	var total: int = 0

	for i in range(spirit_slots.size()):
		if typeof(spirit_slots[i]) != TYPE_DICTIONARY:
			continue
		var spirit: Dictionary = Dictionary(spirit_slots[i])
		var id: String = str(spirit.get("gem_id", ""))
		var enabled: bool = bool(spirit.get("enabled", false))
		var reserve: int = _spirit_reservation(spirit)
		if enabled:
			total += reserve
		var b: Button = SlotButtonScript.new()
		b.custom_minimum_size = Vector2(132, 54)
		b.setup("spirit_%d" % i, ("ON " if enabled else "off ") + _short(_spirit_name(id), 13) + "\n" + str(reserve) + " Spirit", {"kind":"equipped_spirit_gem", "spirit_index":i}, ["support_gem"], i == selected_spirit_index, _spirit_tip(spirit), Color(0.95,0.65,1.0,1), true)
		b.slot_clicked.connect(_select_spirit)
		b.slot_right_clicked.connect(_toggle_spirit)
		b.slot_double_clicked.connect(_toggle_spirit)
		b.slot_dropped.connect(_drop_support_onto_spirit)
		if spirit_box != null:
			spirit_box.add_child(b)

	if spirit_summary_label != null:
		var max_spirit: int = _safe_int(_state_get("spirit_max", 100), 100)
		spirit_summary_label.text = "Spirit Reserved: " + str(total) + " / " + str(max_spirit) + "    Right-click spirits to toggle."
	_state_set("spirit_reserved", total)

func _refresh_detail() -> void:
	if detail_label == null:
		return
	var slot: Dictionary = _selected_active_slot()
	if slot.is_empty():
		detail_label.text = "No active skill selected."
		return

	var id: String = str(slot.get("gem_id", ""))
	var level: int = _safe_int(slot.get("level", 1), 1)
	var xp: int = _safe_int(slot.get("xp", 0), 0)
	var quality: int = _safe_int(slot.get("quality", 0), 0)
	var supports: Array = Array(slot.get("supports", []))
	var unlocked: int = _unlocked_sockets(slot)
	var cast: Dictionary = SkillGemSystemScript.cast_data_for_slot(state_ref, slot)

	var lines: PackedStringArray = []
	lines.append("[b]" + _active_name(id) + "[/b]")
	lines.append("Level " + str(level) + "    XP " + str(xp) + " / " + str(_xp_to_next(level)) + "    Quality +" + str(quality) + "%")
	lines.append("Support Sockets: " + str(unlocked) + " / " + str(MAX_SUPPORT_SOCKETS) + "    Socketed: " + str(supports.size()))
	lines.append("")
	lines.append("[b]Current Cast Preview[/b]")
	lines.append("Damage: " + str(_safe_int(round(_safe_float(cast.get("damage", 0.0))))) + "    Mana: " + str(_safe_int(round(_safe_float(cast.get("mana_cost", 0.0))))) + "    Cost Mult: " + str(_active_cost_multiplier(supports)) + "%")
	lines.append("Tags: " + ", ".join(PackedStringArray(_to_strings(Array(cast.get("tags", []))))))
	lines.append("")
	lines.append("[i]Use this skill to gain XP. Every 5 levels unlocks another support socket. Drag the active gem to stash to remove it with all supports intact.[/i]")
	detail_label.text = "\n".join(lines)

func _select_active_slot(_slot_id: String, payload: Dictionary) -> void:
	_state_set("selected_skill_slot", clampi(_safe_int(payload.get("slot_index", 0), 0), 0, MAX_ACTIVE_SLOTS - 1))
	_rebuild()

func _drop_active_onto_slot(_slot_id: String, payload: Dictionary) -> void:
	if str(payload.get("kind", "")) == "active_gem":
		_install_active_from_stash(_slot_id, payload)

func _install_active_from_stash(_slot_id: String, payload: Dictionary) -> void:
	var stash_index: int = _safe_int(payload.get("stash_index", -1), -1)
	var selected: int = _selected_slot_index()
	var stash: Dictionary = _gem_stash()
	var active_stash: Array = Array(stash.get("active", []))
	if stash_index < 0 or stash_index >= active_stash.size():
		return
	var incoming: Dictionary = Dictionary(active_stash[stash_index])
	var active_slots: Array = Array(_state_get("active_skill_slots", []))
	if selected < 0 or selected >= active_slots.size():
		return
	var previous: Dictionary = Dictionary(active_slots[selected])
	active_stash.remove_at(stash_index)
	if not previous.is_empty():
		active_stash.append(previous)
	active_slots[selected] = incoming
	stash["active"] = active_stash
	_state_set("active_skill_slots", active_slots)
	_state_set("gem_stash", stash)
	_rebuild()

func _drop_active_to_stash(_slot_id: String, payload: Dictionary) -> void:
	if str(payload.get("kind", "")) != "equipped_active_gem":
		return
	var index: int = _safe_int(payload.get("slot_index", -1), -1)
	var active_slots: Array = Array(_state_get("active_skill_slots", []))
	if index < 0 or index >= active_slots.size():
		return
	var removed: Dictionary = Dictionary(active_slots[index])
	var stash: Dictionary = _gem_stash()
	var active_stash: Array = Array(stash.get("active", []))
	active_stash.append(removed)
	stash["active"] = active_stash
	active_slots[index] = _new_active(DEFAULT_ACTIVE_GEMS[index % DEFAULT_ACTIVE_GEMS.size()])
	_state_set("active_skill_slots", active_slots)
	_state_set("gem_stash", stash)
	_state_set("selected_skill_slot", index)
	_rebuild()

func _install_support_from_stash(_slot_id: String, payload: Dictionary) -> void:
	_add_support_to_selected(_safe_int(payload.get("stash_index", -1), -1))

func _drop_support_onto_active_socket(_slot_id: String, payload: Dictionary) -> void:
	if str(payload.get("kind", "")) == "support_gem":
		_add_support_to_selected(_safe_int(payload.get("stash_index", -1), -1))

func _add_support_to_selected(stash_index: int) -> void:
	var active_slots: Array = Array(_state_get("active_skill_slots", []))
	var selected: int = _selected_slot_index()
	if selected < 0 or selected >= active_slots.size():
		return
	var slot: Dictionary = Dictionary(active_slots[selected])
	var supports: Array = Array(slot.get("supports", []))
	if supports.size() >= _unlocked_sockets(slot):
		_notice("No unlocked support socket")
		return
	var stash: Dictionary = _gem_stash()
	var support_stash: Array = Array(stash.get("support", []))
	if stash_index < 0 or stash_index >= support_stash.size():
		return
	var support: Dictionary = Dictionary(support_stash[stash_index])
	var sid: String = str(support.get("gem_id", ""))
	if not GemDBScript.support_compatible(str(slot.get("gem_id", "")), sid):
		_notice("Invalid support")
		return
	support_stash.remove_at(stash_index)
	supports.append(support)
	slot["supports"] = supports
	active_slots[selected] = slot
	stash["support"] = support_stash
	_state_set("active_skill_slots", active_slots)
	_state_set("gem_stash", stash)
	_rebuild()

func _remove_support_from_selected(_slot_id: String, payload: Dictionary) -> void:
	var socket_index: int = _safe_int(payload.get("socket_index", -1), -1)
	var active_slots: Array = Array(_state_get("active_skill_slots", []))
	var selected: int = _selected_slot_index()
	if selected < 0 or selected >= active_slots.size():
		return
	var slot: Dictionary = Dictionary(active_slots[selected])
	var supports: Array = Array(slot.get("supports", []))
	if socket_index < 0 or socket_index >= supports.size():
		return
	var removed: Variant = supports[socket_index]
	supports.remove_at(socket_index)
	slot["supports"] = supports
	active_slots[selected] = slot
	var stash: Dictionary = _gem_stash()
	var support_stash: Array = Array(stash.get("support", []))
	support_stash.append(Dictionary(removed) if typeof(removed) == TYPE_DICTIONARY else _new_support(str(removed)))
	stash["support"] = support_stash
	_state_set("active_skill_slots", active_slots)
	_state_set("gem_stash", stash)
	_rebuild()

func _select_spirit(_slot_id: String, payload: Dictionary) -> void:
	selected_spirit_index = _safe_int(payload.get("spirit_index", -1), -1)
	_rebuild()

func _toggle_spirit(_slot_id: String, payload: Dictionary) -> void:
	var index: int = _safe_int(payload.get("spirit_index", -1), -1)
	var spirits: Array = Array(_state_get("spirit_gem_slots", []))
	if index < 0 or index >= spirits.size() or typeof(spirits[index]) != TYPE_DICTIONARY:
		return
	var spirit: Dictionary = Dictionary(spirits[index])
	spirit["enabled"] = not bool(spirit.get("enabled", false))
	spirits[index] = spirit
	_state_set("spirit_gem_slots", spirits)
	_recompute_spirit_reservation()
	_rebuild()

func _drop_support_onto_spirit(_slot_id: String, payload: Dictionary) -> void:
	if str(payload.get("kind", "")) != "support_gem":
		return
	var spirit_index: int = -1
	var parts: PackedStringArray = str(_slot_id).split("_")
	if parts.size() >= 2:
		spirit_index = _safe_int(parts[1], -1)
	var stash_index: int = _safe_int(payload.get("stash_index", -1), -1)
	var spirits: Array = Array(_state_get("spirit_gem_slots", []))
	var stash: Dictionary = _gem_stash()
	var support_stash: Array = Array(stash.get("support", []))
	if spirit_index < 0 or spirit_index >= spirits.size() or stash_index < 0 or stash_index >= support_stash.size():
		return
	var spirit: Dictionary = Dictionary(spirits[spirit_index])
	var supports: Array = Array(spirit.get("supports", []))
	if supports.size() >= MAX_SUPPORT_SOCKETS:
		_notice("Spirit support sockets full")
		return
	supports.append(Dictionary(support_stash[stash_index]))
	support_stash.remove_at(stash_index)
	spirit["supports"] = supports
	spirits[spirit_index] = spirit
	stash["support"] = support_stash
	_state_set("spirit_gem_slots", spirits)
	_state_set("gem_stash", stash)
	_recompute_spirit_reservation()
	_rebuild()

func _recompute_spirit_reservation() -> void:
	var spirits: Array = Array(_state_get("spirit_gem_slots", []))
	var total: int = 0
	for value in spirits:
		if typeof(value) != TYPE_DICTIONARY:
			continue
		var spirit: Dictionary = Dictionary(value)
		if bool(spirit.get("enabled", false)):
			total += _spirit_reservation(spirit)
	_state_set("spirit_reserved", total)

func _selected_slot_index() -> int:
	return clampi(_safe_int(_state_get("selected_skill_slot", 0), 0), 0, MAX_ACTIVE_SLOTS - 1)

func _selected_active_slot() -> Dictionary:
	var slots: Array = Array(_state_get("active_skill_slots", []))
	var idx: int = _selected_slot_index()
	if idx < 0 or idx >= slots.size() or typeof(slots[idx]) != TYPE_DICTIONARY:
		return {}
	return Dictionary(slots[idx])

func _unlocked_sockets(active_instance: Dictionary) -> int:
	var level: int = max(1, _safe_int(active_instance.get("level", 1), 1))
	return clampi(STARTING_SUPPORT_SOCKETS + int(floor(float(level) / float(SOCKET_LEVEL_INTERVAL))), STARTING_SUPPORT_SOCKETS, MAX_SUPPORT_SOCKETS)

func _xp_to_next(level: int) -> int:
	return max(100, level * 100)

func _active_cost_multiplier(supports: Array) -> int:
	return 100 + supports.size() * 25

func _spirit_reservation(spirit: Dictionary) -> int:
	var data: Dictionary = GemDBScript.spirit(str(spirit.get("gem_id", "")))
	var base: int = _safe_int(data.get("reservation", data.get("spirit_reservation", 25)), 25)
	return int(round(float(base) * (1.0 + float(Array(spirit.get("supports", [])).size()) * 0.20)))

func _active_tip(instance: Dictionary) -> String:
	return _active_name(str(instance.get("gem_id", ""))) + "\nLevel " + str(_safe_int(instance.get("level", 1), 1)) + "\nQuality +" + str(_safe_int(instance.get("quality", 0), 0)) + "%\nSupports: " + str(Array(instance.get("supports", [])).size())

func _support_tip(id: String) -> String:
	var data: Dictionary = GemDBScript.support(id)
	var lines: PackedStringArray = [_support_name(id)]
	if data.has("tags"):
		lines.append("Tags: " + ", ".join(PackedStringArray(_to_strings(Array(data.get("tags", []))))))
	if data.has("description"):
		lines.append(str(data.get("description", "")))
	lines.append("Cost: +25% mana / +20% spirit reservation")
	return "\n".join(lines)

func _spirit_tip(instance: Dictionary) -> String:
	return _spirit_name(str(instance.get("gem_id", ""))) + "\nReservation: " + str(_spirit_reservation(instance)) + "\nRight-click toggles on/off.\nDrop supports here to increase reservation."

func _support_id(value: Variant) -> String:
	return str(Dictionary(value).get("gem_id", "")) if typeof(value) == TYPE_DICTIONARY else str(value)

func _active_name(id: String) -> String:
	return str(GemDBScript.active(id).get("name", id))

func _support_name(id: String) -> String:
	return str(GemDBScript.support(id).get("name", id))

func _spirit_name(id: String) -> String:
	return str(GemDBScript.spirit(id).get("name", id))

func _short(value: String, limit: int) -> String:
	var clean: String = value.strip_edges()
	return clean if clean.length() <= limit else clean.substr(0, max(1, limit - 1)) + "…"

func _close_panel() -> void:
	_state_set("panel_mode", "")

func _notice(text: String) -> void:
	if state_ref != null and state_ref.has_method("add_notice"):
		state_ref.call("add_notice", text)

func _safe_float(value: Variant, fallback: float = 0.0) -> float:
	if value == null:
		return fallback
	match typeof(value):
		TYPE_FLOAT: return value
		TYPE_INT: return float(value)
		TYPE_STRING:
			var s: String = str(value)
			return s.to_float() if s.is_valid_float() else fallback
		_: return fallback

func _safe_int(value: Variant, fallback: int = 0) -> int:
	if value == null:
		return fallback
	match typeof(value):
		TYPE_INT: return value
		TYPE_FLOAT: return int(round(value))
		TYPE_STRING:
			var s: String = str(value)
			return s.to_int() if s.is_valid_int() else fallback
		_: return fallback

func _to_strings(values: Array) -> Array:
	var out: Array = []
	for value in values:
		out.append(str(value))
	return out


func _rf_092c_ensure_skill_ux() -> void:
	if _rf_092c_skill_detail != null and is_instance_valid(_rf_092c_skill_detail):
		return
	var host: Control = _rf_092c_find_vbox(self)
	if host == null:
		host = self as Control
	_rf_092c_skill_detail = RichTextLabel.new()
	_rf_092c_skill_detail.name = "SkillGemDetail092C"
	_rf_092c_skill_detail.custom_minimum_size = Vector2(0, 168)
	_rf_092c_skill_detail.bbcode_enabled = true
	_rf_092c_skill_detail.fit_content = false
	_rf_092c_skill_detail.scroll_active = true
	_rf_092c_skill_detail.text = SkillGemUXSystemScript.panel_hint()
	host.add_child(_rf_092c_skill_detail)
	_rf_092c_skill_timer = Timer.new()
	_rf_092c_skill_timer.name = "SkillGemUXRefreshTimer092C"
	_rf_092c_skill_timer.wait_time = 0.25
	_rf_092c_skill_timer.one_shot = false
	_rf_092c_skill_timer.autostart = true
	add_child(_rf_092c_skill_timer)
	_rf_092c_skill_timer.timeout.connect(_rf_092c_refresh_skill_ux)
	_rf_092c_refresh_skill_ux()

func _rf_092c_refresh_skill_ux() -> void:
	if _rf_092c_skill_detail == null or not is_instance_valid(_rf_092c_skill_detail):
		return
	var state: Object = _rf_092c_state()
	if state == null:
		_rf_092c_skill_detail.text = SkillGemUXSystemScript.panel_hint()
		return
	_rf_092c_skill_detail.text = SkillGemUXSystemScript.selected_skill_detail(state) + "\n\n" + SkillGemUXSystemScript.loadout_overview(state)

func _rf_092c_state() -> Object:
	var value: Variant = get("state_ref")
	return value as Object

func _rf_092c_find_vbox(root: Node) -> Control:
	if root is VBoxContainer:
		return root as Control
	for child: Node in root.get_children():
		var found: Control = _rf_092c_find_vbox(child)
		if found != null:
			return found
	return null
